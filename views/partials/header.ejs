<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Dangcagan National High School Digital Herbarium — a QR code-enhanced herbal plant collection documenting Philippine medicinal plants.' %>" />
  <title><%= title %></title>

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />

  <!-- Google Fonts: Cormorant Garamond for headings, Inter for body -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- App styles -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Open Graph (for sharing links) -->
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="Dangcagan NHS Digital Herbarium — QR code-enhanced herbal plant collection." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/images/logo.jpeg" />
</head>
<body>
  <!-- Skip link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- ─── Header / Navigation ──────────────────────────────── -->
  <header class="site-header" id="siteHeader">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="Dangcagan NHS Herbarium Home">
        <span class="brand-logos">
          <img src="/images/logo.jpeg" alt="Dangcagan National High School logo" class="brand-logo" width="40" height="40" />
          <img src="/images/logo2.jpeg" alt="STEM logo" class="brand-logo brand-logo-alt" width="40" height="40" />
        </span>
        <span class="brand-text">          <span class="brand-name">Dangcagan NHS</span>
          <span class="brand-tagline">Digital Herbarium</span>
        </span>
      </a>

      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav" id="navMenu" aria-label="Primary">
        <a href="/" class="nav-link<%= currentPath === '/' ? ' is-active' : '' %>">Home</a>
        <a href="/browse" class="nav-link<%= currentPath === '/home' ? ' is-active' : '' %>">Collection</a>
        <a href="/search" class="nav-link<%= currentPath === '/search' ? ' is-active' : '' %>">Search</a>
        <a href="/qrcodes" class="nav-link<%= currentPath === '/qrcodes' ? ' is-active' : '' %>">QR Codes</a>
        <a href="/about" class="nav-link<%= currentPath === '/about' ? ' is-active' : '' %>">About</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
