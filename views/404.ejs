<%- include('partials/header', { title: title || 'Page Not Found', currentPath }) %>

<section class="not-found">
  <div class="container">
    <div class="nf-illustration" aria-hidden="true">
      <svg width="160" height="160" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="90" stroke="var(--sage)" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.4"/>
        <path d="M100 50 Q 130 80 100 110 Q 70 80 100 50 Z" fill="var(--primary)" opacity="0.15"/>
        <path d="M100 60 L100 110" stroke="var(--primary)" stroke-width="2"/>
        <path d="M85 70 Q 100 80 115 70" stroke="var(--primary)" stroke-width="2" fill="none"/>
        <path d="M82 85 Q 100 95 118 85" stroke="var(--primary)" stroke-width="2" fill="none"/>
        <text x="100" y="145" text-anchor="middle" font-size="14" fill="var(--muted)" font-family="Inter, sans-serif">404</text>
      </svg>
    </div>
    <h1 class="page-title">Page Not Found</h1>
    <p class="page-subtitle"><%= typeof message !== 'undefined' ? message : 'The page you are looking for doesn\'t exist or has been moved.' %></p>
    <div class="hero-actions" style="justify-content:center;">
      <a href="/" class="btn btn-primary">Back to Home</a>
      <a href="/browse" class="btn btn-ghost">Browse Plants</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
