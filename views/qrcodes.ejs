<%- include('partials/header', { title, currentPath }) %>

<!-- ─── Header ─────────────────────────────────────────────── -->
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Printable QR Index</span>
    <h1 class="page-title">QR Code Index</h1>
    <p class="page-subtitle">
      Every plant in the collection has a unique QR code linking to its detail page.
      Print these and attach them to the physical specimens in the school garden.
    </p>
    <button type="button" class="btn btn-outline" onclick="window.print()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print all QR codes
    </button>
  </div>
</section>

<!-- ─── QR Grid ───────────────────────────────────────────── -->
<section class="section">
  <div class="container">
    <div class="qr-grid">
      <% plants.forEach(plant => { %>
        <article class="qr-card reveal" data-reveal>
          <div class="qr-card-img">
            <img src="<%= plant.image %>" alt="<%= plant.name %>" loading="lazy" />
          </div>
          <div class="qr-card-info">
            <h3 class="qr-card-title"><%= plant.name %></h3>
            <p class="qr-card-latin"><em><%= plant.scientificName %></em></p>
          </div>
          <div class="qr-card-qr" data-url="<%= plant.qrUrl %>" data-name="<%= plant.name %>"></div>
          <a href="/plant/<%= plant.slug %>" class="btn btn-sm btn-outline btn-block">View plant</a>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
